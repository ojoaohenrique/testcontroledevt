{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/login.html", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
